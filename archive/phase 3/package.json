{
  "name": "pholo-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Pholo CMS (Clinic Management System)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "dotenv -e .env -- node dev.mjs",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "db:reset": "dotenv -e .env -- supabase db reset --linked",
    "test:unit": "dotenv -e .env -- jest --selectProjects types api-unit web-unit",
    "test:component": "dotenv -e .env -- jest --selectProjects web-component",
    "test:db": "dotenv -e .env -- jest --selectProjects db --runInBand",
    "test:int": "dotenv -e .env -- jest --selectProjects api-int --runInBand",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs --max-warnings 0",
    "typecheck": "npm run typecheck -w packages/types && npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:component && npm run test:db && npm run test:int"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supabase": "^1.200.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
